{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "preserve",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"paths": {
			"@magic-helix/core": ["../packages/magic-helix-core/src/browser.ts"]
		},
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}
