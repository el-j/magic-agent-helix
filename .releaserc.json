{
	"branches": [
		"main",
		{
			"name": "develop",
			"prerelease": "beta"
		},
		{
			"name": "feature/*",
			"prerelease": "alpha"
		}
	],
	"plugins": [
		[
			"@semantic-release/commit-analyzer",
			{
				"preset": "conventionalcommits",
				"releaseRules": [
					{
						"type": "build",
						"scope": "deps",
						"release": "patch"
					}
				]
			}
		],
		[
			"@semantic-release/release-notes-generator",
			{
				"preset": "conventionalcommits"
			}
		],
		[
			"@semantic-release/changelog",
			{
				"changelogFile": "CHANGELOG.md"
			}
		],
		[
			"@semantic-release/npm",
			{
				"pkgRoot": "packages/magic-helix-core"
			}
		],
		[
			"@semantic-release/npm",
			{
				"pkgRoot": "packages/magic-agent-helix"
			}
		],
		[
			"@semantic-release/github",
			{
				"assets": [
					{
						"path": "packages/magic-agent-helix/dist/**",
						"label": "CLI Distribution"
					}
				]
			}
		],
		[
			"@semantic-release/git",
			{
				"assets": [
					"package.json",
					"packages/magic-helix-core/package.json",
					"packages/magic-agent-helix/package.json",
					"package-lock.json",
					"CHANGELOG.md"
				],
				"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
			}
		]
	]
}
