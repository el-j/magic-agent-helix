{
	"name": "magic-agent-helix-monorepo",
	"version": "1.4.0",
	"private": true,
	"description": "Monorepo for MagicAgentHelix CLI and VS Code Extension",
	"workspaces": [
		"packages/magic-helix-core",
		"packages/magic-agent-helix",
		"packages/vscode-magic-helix",
		"packages/magic-helix-plugins",
		"playground"
	],
	"engines": {
		"node": "^20.11.1 || >=22.0.0"
	},
	"scripts": {
		"build": "npm run build --workspace=@magic-helix/core && npm run build --workspace=@magic-helix/agent && npm run build --workspace=@magic-helix/vscode",
		"build:core": "npm run build --workspace=@magic-helix/core",
		"build:cli": "npm run build --workspace=@magic-helix/agent",
		"build:vscode": "npm run build --workspace=@magic-helix/vscode",
		"build:playground": "npm run build --workspace=playground",
		"dev:playground": "npm run dev --workspace=playground",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"semantic-release": "semantic-release"
	},
	"keywords": [
		"magic-agent-helix",
		"copilot",
		"ai"
	],
	"author": "Your Name / Community",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.3",
		"@semantic-release/npm": "^12.0.2",
		"@types/mocha": "^10.0.9",
		"@types/node": "^20.17.15",
		"@types/vscode": "^1.95.0",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vitest/coverage-v8": "^3.1.4",
		"@vscode/test-cli": "^0.0.12",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"mocha": "^10.8.2",
		"pkg": "^5.8.1",
		"semantic-release": "^24.2.0",
		"tailwindcss": "^3.4.18",
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"vitest": "^3.1.4",
		"vue": "^3.5.24",
		"vue-tsc": "^2.2.0"
	}
}
