{
  "name": "magic-agent-helix-monorepo",
  "version": "3.0.1-beta.1",
  "private": true,
  "description": "Monorepo for MagicAgentHelix CLI and VS Code Extension",
  "workspaces": [
    "packages/magic-helix-core",
    "packages/magic-agent-helix",
    "packages/vscode-magic-helix",
    "packages/magic-helix-plugins",
    "playground"
  ],
  "engines": {
    "node": "^20.11.1 || >=22.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace=@magic-helix/core && npm run build --workspace=@magic-helix/agent && npm run build --workspace=magic-helix-vscode && npm run build --workspace=@magic-helix/plugins",
    "build:core": "npm run build --workspace=@magic-helix/core",
    "build:cli": "npm run build --workspace=@magic-helix/agent",
    "build:vscode": "npm run build --workspace=magic-helix-vscode",
    "build:playground": "npm run build --workspace=playground",
    "dev:playground": "npm run dev --workspace=playground",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:core && npm run lint && npm run format:check",
    "test:core": "npm run test --workspace=@magic-helix/core",
    "test:core:watch": "npm run test:watch --workspace=@magic-helix/core",
    "test:core:coverage": "npm run test:coverage --workspace=@magic-helix/core",
    "test:core:combiner": "npm run test:combiner --workspace=@magic-helix/core",
    "test:core:integration": "npm run test:integration --workspace=@magic-helix/core",
    "test:core:telemetry": "cd packages/magic-helix-core && npx vitest run src/telemetry.test.ts --reporter=verbose",
    "validate:instructions": "npm run build:cli && node packages/magic-agent-helix/dist/cli.mjs validate",
    "sync:versions": "node scripts/sync-versions.js",
    "sync:versions:set": "node scripts/sync-versions.js --set",
    "pre-commit": "npm run lint:fix && npm run format",
    "install:hooks": "echo '#!/bin/sh\nnpm run pre-commit' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && echo 'Pre-commit hook installed!'",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "magic-agent-helix",
    "copilot",
    "ai"
  ],
  "author": "Your Name / Community",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^12.0.2",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.17.15",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.1.4",
    "@vscode/test-cli": "^0.0.12",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "mocha": "^10.8.2",
    "pkg": "^5.8.1",
    "semantic-release": "^24.2.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.1.4",
    "vue": "^3.5.24",
    "vue-tsc": "^2.2.0"
  }
}
