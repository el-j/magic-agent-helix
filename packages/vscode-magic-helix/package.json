{
	"name": "vscode-magic-helix",
	"displayName": "MagicAgentHelix Runner",
	"description": "Runs the MagicAgentHelix CLI from VS Code to align AI instructions in your monorepo.",
	"version": "0.1.0",
	"publisher": "YOUR_PUBLISHER_NAME",
	"repository": {
		"type": "git",
		"url": "https://github.com/YOUR_USERNAME/magic-agent-helix.git"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "magic-helix.run",
				"title": "Run MagicAgentHelix",
				"category": "MagicAgentHelix",
				"icon": "$(wand)"
			},
			{
				"command": "magic-helix.refresh",
				"title": "Refresh MagicAgentHelix",
				"category": "MagicAgentHelix",
				"icon": "$(sync)"
			},
			{
				"command": "magic-helix.list",
				"title": "List Projects & Tags",
				"category": "MagicAgentHelix",
				"icon": "$(list-tree)"
			},
			{
				"command": "magic-helix.validate",
				"title": "Validate Instruction Files",
				"category": "MagicAgentHelix",
				"icon": "$(checklist)"
			},
			{
				"command": "magic-helix.clean",
				"title": "Clean Generated Files",
				"category": "MagicAgentHelix",
				"icon": "$(trash)"
			},
			{
				"command": "magic-helix.showOutput",
				"title": "Show Output",
				"category": "MagicAgentHelix",
				"icon": "$(output)"
			},
			{
				"command": "magic-helix.showStatus",
				"title": "Show Status Panel",
				"category": "MagicAgentHelix",
				"icon": "$(graph)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "magic-helix.run",
					"when": "workspaceFolderCount > 0"
				},
				{
					"command": "magic-helix.refresh",
					"when": "workspaceFolderCount > 0"
				},
				{
					"command": "magic-helix.list",
					"when": "workspaceFolderCount > 0"
				},
				{
					"command": "magic-helix.validate",
					"when": "workspaceFolderCount > 0"
				},
				{
					"command": "magic-helix.clean",
					"when": "workspaceFolderCount > 0"
				},
				{
					"command": "magic-helix.showOutput",
					"when": "workspaceFolderCount > 0"
				},
				{
					"command": "magic-helix.showStatus",
					"when": "workspaceFolderCount > 0"
				}
			]
		}
	},
	"scripts": {
		"build": "tsc --build"
	},
	"dependencies": {
		"@types/node": "^20.11.0"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"typescript": "^5.0.0"
	}
}
