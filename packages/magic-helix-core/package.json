{
  "name": "@el-j/magic-helix-core",
  "version": "4.0.0-beta.6",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": "^20.11.1 || >=22.0.0"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:combiner": "vitest run src/pattern-combiner.test.ts --reporter=verbose",
    "test:integration": "vitest run src/integration.test.ts --reporter=verbose",
    "build:types": "tsc --project tsconfig.declarations.json --outDir dist",
    "build:bundle": "vite build"
  },
  "keywords": [
    "magic-agent-helix",
    "copilot",
    "github-copilot",
    "ai"
  ],
  "author": "Your Name / Community",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@el-j/magic-helix-plugins": "*",
    "@iarna/toml": "^3.0.0",
    "commander": "^14.0.2",
    "glob": "^13.0.0",
    "gradient-string": "^3.0.0",
    "inquirer": "^13.1.0",
    "js-yaml": "^4.1.1",
    "ora": "^9.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "vite": "^7.3.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ]
}
